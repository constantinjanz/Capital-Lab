{
  "name": "capital-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --fail-on-flaky-tests",
    "test:db": "node scripts/run-database-tests.mjs",
    "test:safety": "node scripts/check-paper-only.mjs",
    "test:credentials": "node scripts/check-credential-patterns.mjs",
    "openai:models:check": "node --conditions=react-server --import tsx scripts/check-openai-model-access.ts",
    "openai:canary": "node scripts/run-openai-paid-canary-child.mjs",
    "pricing:verify": "node --import tsx scripts/verify-model-pricing.ts",
    "backup:critical": "node scripts/export-critical-tables.mjs",
    "backup:golden:prove-reference": "node scripts/prepare-schema-golden-reference-proof.mjs",
    "backup:golden:update": "node scripts/capture-backup-schema-golden.mjs",
    "backup:golden:bootstrap": "node scripts/bootstrap-schema-goldens.mjs",
    "backup:golden:verify-candidate": "node scripts/verify-schema-golden-candidate-artifact.mjs",
    "backup:contracts:generate": "node scripts/generate-backup-contracts.mjs --write",
    "backup:contracts:verify": "node scripts/generate-backup-contracts.mjs --verify",
    "backup:restore:test": "node scripts/verify-backup-restore.mjs",
    "migration:rehearse:local": "node scripts/run-local-rollback-migration-rehearsal.mjs",
    "activation:phase": "node scripts/run-activation-phase.mjs",
    "activation:vercel-proof": "node scripts/vercel-deployment-proof.mjs",
    "activation:contract:generate": "node scripts/activation-phase-contract.mjs --write",
    "activation:contract:verify": "node scripts/activation-phase-contract.mjs --verify",
    "checksums:generate": "node scripts/handoff-checksums.mjs --write",
    "checksums:verify": "node scripts/handoff-checksums.mjs --verify",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:safety && pnpm test:credentials && pnpm build"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "decimal.js": "10.6.0",
    "lucide-react": "^1.29.0",
    "next": "16.3.0",
    "openai": "7.4.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-security": "^4.0.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.2"
}
