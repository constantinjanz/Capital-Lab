# Public Supabase configuration. Both values are required together for live auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only owner configuration. The application does not use a Supabase secret key.
OWNER_EMAIL=owner@example.com
OWNER_BOOTSTRAP_ENABLED=false

# Optional remote integrations. Leave credentials blank while their providers are disabled.
OPENAI_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex
CRON_SECRET=

# Safe local defaults.
SCHEDULER_PROVIDER=manual
AGENT_ENABLED=false
AGENT_EXECUTION_MODE=shadow
SOL_ENABLED=false
OPENAI_WEB_SEARCH_ENABLED=false
MARKET_DATA_PROVIDER=mock
NEWS_PROVIDER=mock
EMBEDDING_PROVIDER=mock
APP_BASE_URL=http://localhost:3000

# Hard OpenAI controls (USD decimal strings; New York budget periods).
AI_LIFETIME_HARD_LIMIT_USD=50.00
AI_MONTHLY_SOFT_TARGET_USD=6.30
AI_MONTHLY_HARD_LIMIT_USD=10.00
AI_TRADING_DAY_HARD_LIMIT_USD=0.30
BUDGET_TIMEZONE=America/New_York
