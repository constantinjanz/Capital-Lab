# Public Supabase configuration. Both values are required together for live auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only owner configuration.
OWNER_EMAIL=owner@example.com
OWNER_BOOTSTRAP_ENABLED=false

# Server-only runtime mutation key. Keep blank while AGENT_ENABLED=false.
# Never expose this value to the browser or commit it. Rotate any key pasted into chat.
SUPABASE_SECRET_KEY=

# Optional remote integrations. Leave credentials blank while their providers are disabled.
OPENAI_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex
SCHEDULER_SHARED_SECRET=

# Safe local defaults.
SCHEDULER_ENABLED=false
SCHEDULER_PROVIDER=supabase
AGENT_ENABLED=false
AGENT_EXECUTION_MODE=mock
AUTONOMOUS_PAPER_EXECUTION_ENABLED=false
PAID_MODEL_CALLS_ENABLED=false
OPENAI_CANARY_ENABLED=false
SOL_ENABLED=false
SOL_CHALLENGER_ENABLED=false
SOL_LIVE_EXECUTION_ENABLED=false
OPENAI_WEB_SEARCH_ENABLED=false
REAL_BROKER_ENABLED=false
MARKET_DATA_PROVIDER=mock
NEWS_PROVIDER=mock
EMBEDDING_PROVIDER=mock
APP_BASE_URL=http://localhost:3000

# Hard OpenAI controls (USD decimal strings; New York budget periods).
AI_LIFETIME_HARD_LIMIT_USD=50.00
AI_EXPERIMENT_HARD_LIMIT_USD=30.00
AI_MONTHLY_SOFT_TARGET_USD=8.00
AI_MONTHLY_HARD_LIMIT_USD=10.00
AI_TRADING_DAY_SOFT_TARGET_USD=0.25
AI_TRADING_DAY_HARD_LIMIT_USD=0.40
BUDGET_TIMEZONE=America/New_York
